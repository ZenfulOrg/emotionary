{
  "expo": {
    "name": "Emotionary",
    "slug": "emotionary",
    "version": "1.5.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "emotionary",
    "userInterfaceStyle": "light",
    "ios": {
      "appleTeamId": "GRM466YG9B",
      "bundleIdentifier": "com.nowdrops.emotionary",
      "buildNumber": "2026083001",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": []
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.emotionary.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow Emotionary to save word cards to your photos.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "./plugins/with-widget-assets",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.nowdrops.emotionary.widgets",
          "groupIdentifier": "group.com.nowdrops.emotionary",
          "widgets": [
            {
              "name": "DailyWord",
              "displayName": "Emotionary Daily Word",
              "description": "Keep today's emotion word close on your Home or Lock Screen.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "configuration": {
                  "title": "Emotionary Widget",
                  "description": "Choose the atmosphere for your daily word.",
                  "parameters": {
                    "theme": {
                      "title": "Theme",
                      "type": "enum",
                      "values": [
                        {
                          "name": "Word Color",
                          "value": "automatic"
                        },
                        {
                          "name": "Moody Nature",
                          "value": "moodyNature"
                        },
                        {
                          "name": "Dusky Rose",
                          "value": "duskyRose"
                        }
                      ],
                      "default": "automatic"
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
