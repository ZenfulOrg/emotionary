<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="#F5F0E6">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EMOTIONARY · DAILY WORD" android:textSize="10sp" android:textColor="#18334D" android:fontFamily="monospace" />
  <TextView android:id="@+id/word" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Emotionary" android:textSize="30sp" android:textColor="#18334D" android:fontFamily="serif" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/definition" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:text="A word for what you feel." android:textSize="15sp" android:textColor="#18334D" android:maxLines="5" android:ellipsize="end" />
  <TextView android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="DAILY WORD" android:textSize="10sp" android:textColor="#18334D" android:fontFamily="monospace" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
